        "localSyntax": "baseline | alphabetic | ideographic | middle | central | mathematical | text-before-edge | text-after-edge",
        "mdnSyntax": "baseline | <baseline-metric>",
        "mdnVerified": true,
        "mdnValues": {
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/alignment-baseline#values",
          "uncertain": false,
          "entries": [
            {
              "id": "baseline",
              "label": "baseline",
              "description": "Use the dominant-baseline value of the parent."
            },
            {
              "id": "alphabetic",
              "label": "alphabetic",
              "description": "Used in writing Latin, Cyrillic, Greek, and many other scripts; matches the box's alphabetic baseline to that of its parent, corresponding to the bottom of most, but not all characters."
            },
            {
              "id": "central",
              "label": "central",
              "description": "Matches the box's central baseline to the central baseline of its parent, corresponding to the ideographic central baseline, halfway between the ideographic-under and ideographic-over baselines."
            },
            {
              "id": "ideographic",
              "label": "ideographic",
              "description": "Matches the box's ideographic character face under-side baseline to that of its parent, with the derived baseline-table constructed using the ideographic baseline-table in the font."
            },
            {
              "id": "mathematical",
              "label": "mathematical",
              "description": "Matches the box's mathematical baseline to that of its parent, corresponding to the center baseline around which mathematical characters are designed."
            },
            {
              "id": "middle",
              "label": "middle",
              "description": "Aligns the vertical midpoint of the box with the baseline of the parent box plus half the x-height of the parent. Uses the x-middle baselines; except under text-orientation: upright; (where the alphabetic and x-height baselines are essentially meaningless), in which case it uses the central baseline instead."
            },
            {
              "id": "text-bottom",
              "label": "text-bottom",
              "description": "Matches the bottom of the box to the top of the parent's content area, using the line-under edge of an inline's content box."
            },
            {
              "id": "text-top",
              "label": "text-top",
              "description": "Matches the top of the box to the top of the parent's content area; the line-over edge of an inline's content box."
            }
          ]
        },
        "sourceAgreement": "verified",
        "sampleCaseCount": 4
