{
  "version": 2,
  "strategy": "conservative-box-first-layout-second",
  "scope": "first-batch-plus-second-batch-design",
  "renderingDefaults": {
    "hintSide": "left",
    "suffix": ":",
    "padding": " "
  },
  "families": [
    {
      "family": "box-sides",
      "kind": "sides",
      "stage": 1,
      "priority": 10,
      "properties": [
        "margin",
        "padding",
        "border-width",
        "border-style",
        "border-color"
      ],
      "slots": ["top", "right", "bottom", "left"],
      "labelsByArity": {
        "1": ["all"],
        "2": ["top/bottom", "right/left"],
        "3": ["top", "right/left", "bottom"],
        "4": ["top", "right", "bottom", "left"]
      },
      "notes": [
        "Use the same slot mapping for all four-edge shorthands.",
        "Prefer role labels over type labels.",
        "Keep single-value shorthand as all, not a type-specific label."
      ]
    },
    {
      "family": "box-corners",
      "kind": "corners",
      "stage": 1,
      "priority": 9,
      "properties": ["border-radius"],
      "slots": ["top-left", "top-right", "bottom-right", "bottom-left"],
      "labelsByArity": {
        "1": ["all"],
        "2": ["top-left/bottom-right", "top-right/bottom-left"],
        "3": ["top-left", "top-right/bottom-left", "bottom-right"],
        "4": ["top-left", "top-right", "bottom-right", "bottom-left"]
      },
      "notes": [
        "Keep corner mapping separate from edge mapping.",
        "Use only when the value count makes the slot meaning stable.",
        "Do not mix this family with grid or flex semantics."
      ]
    }
  ],
  "secondBatch": {
    "stage": 2,
    "scope": "layout-core",
    "focus": [
      "flex",
      "flex-flow",
      "grid-area",
      "grid-row",
      "grid-column",
      "grid",
      "grid-template"
    ],
    "families": [
      {
        "family": "layout-flex",
        "kind": "layout",
        "stage": 2,
        "priority": 20,
        "properties": ["flex", "flex-flow"],
        "dispatch": "grammar-disambiguated",
        "subfamilies": [
          {
            "property": "flex",
            "status": "design",
            "todos": [
              "Keep none as suppress in the current second batch.",
              "Implement global values as a future right-side hint pass."
            ],
            "forms": [
              {
                "name": "none",
                "emit": "suppress",
                "status": "design",
                "notes": [
                  "Design suppression only; no left-side hint.",
                  "Do not treat none as a structural hint candidate."
                ]
              },
              {
                "name": "global-values",
                "emit": "defer",
                "status": "todo",
                "presentation": "right",
                "values": [
                  "inherit",
                  "initial",
                  "revert",
                  "revert-layer",
                  "unset"
                ],
                "notes": [
                  "Future result-summary style hint, not part of the current left-side pass.",
                  "Keep this out of the second-batch implementation until the left-side forms are stable."
                ]
              },
              {
                "name": "single-number",
                "when": "numeric-token",
                "labels": ["grow"]
              },
              {
                "name": "single-basis",
                "when": "basis-token",
                "labels": ["basis"]
              },
              {
                "name": "two-token",
                "when": "numeric-numeric",
                "labels": ["grow", "shrink"]
              },
              {
                "name": "two-token-grow-basis",
                "when": "numeric-basis-token",
                "labels": ["grow", "basis"],
                "examples": [
                  "flex: 1 30px",
                  "flex: 1 30%",
                  "flex: 1 min-content"
                ],
                "notes": [
                  "This is the missing two-value case from the flex examples.",
                  "The second token is basis-like, not shrink-like, so it must stay separate from numeric-numeric."
                ]
              },
              {
                "name": "three-token",
                "when": "numeric-numeric-basis",
                "labels": ["grow", "shrink", "basis"]
              }
            ],
            "notes": [
              "Do not rely on arity alone; the single-token form needs token-class disambiguation.",
              "Keep none as a no-hint case.",
              "This family is still conservative: only classify forms whose token shape is stable."
            ]
          },
          {
            "property": "flex-flow",
            "status": "design",
            "todos": [
              "Keep global values as a future right-side hint pass.",
              "Do not add extra flex-flow cases beyond the provided examples."
            ],
            "forms": [
              {
                "name": "single-direction",
                "when": "direction-keyword",
                "labels": ["direction"]
              },
              {
                "name": "single-wrap",
                "when": "wrap-keyword",
                "labels": ["wrap"]
              },
              {
                "name": "direction-wrap",
                "when": "direction-keyword-plus-wrap-keyword",
                "labels": ["direction", "wrap"]
              },
              {
                "name": "global-values",
                "emit": "defer",
                "status": "todo",
                "presentation": "right",
                "values": [
                  "inherit",
                  "initial",
                  "revert",
                  "revert-layer",
                  "unset"
                ],
                "notes": [
                  "Future result-summary style hint, not part of the current left-side pass.",
                  "Keep this out of the second-batch implementation until the left-side forms are stable."
                ]
              }
            ],
            "notes": [
              "Keep the keyword classifier explicit because one token can mean either axis.",
              "Prefer stable direction/wrap labels over generic parameter labels."
            ]
          }
        ],
        "notes": [
          "Second batch should start with flex because the grammar is smaller than grid.",
          "Keep flex and flex-flow together, but do not mix them with alignment properties in the first second-batch pass."
        ]
      },
      {
        "family": "layout-grid",
        "kind": "layout",
        "stage": 2,
        "priority": 19,
        "properties": [
          "grid-area",
          "grid-row",
          "grid-column",
          "grid",
          "grid-template"
        ],
        "dispatch": "grammar-disambiguated",
        "subfamilies": [
          {
            "property": "grid-area",
            "status": "design",
            "forms": [
              {
                "name": "named-area",
                "emit": "suppress"
              },
              {
                "name": "two-slot-position",
                "when": "slash-separated-2",
                "slots": ["row-start", "column-start"]
              },
              {
                "name": "three-slot-position",
                "when": "slash-separated-3",
                "slots": ["row-start", "column-start", "row-end"]
              },
              {
                "name": "four-slot-position",
                "when": "slash-separated-4",
                "slots": ["row-start", "column-start", "row-end", "column-end"]
              }
            ],
            "notes": [
              "Keep the named-area form out of the hint set for now.",
              "Only emit when the slash-separated slot count is explicit and stable."
            ]
          },
          {
            "property": "grid-row",
            "status": "design",
            "forms": [
              {
                "name": "slash-separated-line",
                "when": "slash-separated-2",
                "slots": ["start", "end"]
              }
            ],
            "notes": [
              "Treat a lone token as too ambiguous for the second batch.",
              "Only the explicit start/end form is conservative enough."
            ]
          },
          {
            "property": "grid-column",
            "status": "design",
            "forms": [
              {
                "name": "slash-separated-line",
                "when": "slash-separated-2",
                "slots": ["start", "end"]
              }
            ],
            "notes": [
              "Treat a lone token as too ambiguous for the second batch.",
              "Only the explicit start/end form is conservative enough."
            ]
          },
          {
            "property": "grid",
            "status": "defer",
            "notes": [
              "Keep for a later pass; the grammar branches are broader than a slot map.",
              "Do not collapse template and track-list semantics into the second batch."
            ]
          },
          {
            "property": "grid-template",
            "status": "defer",
            "notes": [
              "Keep for a later pass; template parsing needs a separate classifier.",
              "Do not mix it with the simpler line-based grid shorthands."
            ]
          }
        ],
        "notes": [
          "Grid should start with the line-based members because they are easier to classify conservatively.",
          "Delay template-level grammar until the line-based pass is settled."
        ]
      }
    ]
  },
  "laterFamilies": [
    {
      "family": "layout-alignment",
      "kind": "layout",
      "stage": 3,
      "priority": 30,
      "properties": [
        "align-content",
        "align-items",
        "align-self",
        "justify-content",
        "justify-items",
        "justify-self"
      ],
      "status": "later",
      "notes": [
        "These are not shorthand slot families, so they should stay out of the flex/grid second batch.",
        "Bring them in only after the core flex/grid grammar is stable."
      ]
    }
  ],
  "selectionPolicy": {
    "firstBatch": "box-only",
    "secondBatch": "layout-core-only",
    "includeLogicalBox": false,
    "includeLayoutFamilies": false,
    "conservativeOnly": true
  }
}
