{
	"compilerOptions": {
		"module": "CommonJS",
		"moduleResolution": "Node",
		"ignoreDeprecations": "5.0",
		"target": "ES2022",
		"lib": ["ES2022"],
		"rootDir": "src",
		"outDir": "out",
		"sourceMap": true,
		"strict": true,
		"types": ["node"],
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src"],
	"exclude": ["node_modules", ".vscode-test", "out"]
}
